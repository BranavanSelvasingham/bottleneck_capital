# Bottleneck Capital live-signal setup.
# Copy these names into the environment used by Codex automations; do not commit real secrets.

# Preferred market source. If omitted, `bcap live-check` uses the Yahoo fallback.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=

# SEC requires a descriptive User-Agent with contact information.
BCAP_SEC_USER_AGENT="Bottleneck Capital your-email@example.com"

# Pace SEC browse Atom fallback requests. Increase if SEC returns 403/rate-limit responses.
BCAP_SEC_REQUEST_DELAY_SECONDS=0.35

# Optional SEC mirrors/proxies for environments where direct SEC access is blocked.
BCAP_SEC_COMPANY_TICKERS_URL=
BCAP_SEC_SUBMISSIONS_URL_TEMPLATE=
BCAP_SEC_BROWSE_ATOM_URL=

# Optional live filing vendor/proxy feed. Expected JSON:
# {"covered_tickers":["NVDA"],"events":[{"ticker":"NVDA","filing_type":"8-K",...}]}
BCAP_FILING_EVENTS_URL=
BCAP_FILING_EVENTS_AUTH_HEADER=
