    {
      "id": "text_7r_j3xofn",
      "type": "text",
      "x": 370,
      "y": 1478,
      "width": 1160,
      "height": 23,
      "angle": 0,
      "strokeColor": "#334155",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 2782467,
      "version": 1,
      "versionNonce": 2209401,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1782524616482,
      "link": null,
      "locked": false,
      "text": "Decision files currently reflect active-signal pressure: most names are RESEARCH_REQUIRED until dip causes and material events are reviewed or resolved append-only. Asset frontmatter still carries baseline house views, including one older BUY_NOW baseline, so the board/decision engine is the operational truth surface.",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 19,
      "containerId": null,
      "originalText": "Decision files currently reflect active-signal pressure: most names are RESEARCH_REQUIRED until dip causes and material events are reviewed or resolved append-only. Asset frontmatter still carries baseline house views, including one older BUY_NOW baseline, so the board/decision engine is the operational truth surface.",
      "lineHeight": 1.25
    },
    {
      "id": "text_7t_bjifk2",
      "type": "text",
      "x": 1580,
      "y": 1478,
      "width": 820,
      "height": 23,
      "angle": 0,
      "strokeColor": "#334155",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 2802413,
      "version": 1,
      "versionNonce": 2225239,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1782524616482,
      "link": null,
      "locked": false,
      "text": "Validation rule of thumb: after process/universe changes run bcap validate; before resuming market-day automation run bcap validate --strict-live or bcap resume-check.",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 19,
      "containerId": null,
      "originalText": "Validation rule of thumb: after process/universe changes run bcap validate; before resuming market-day automation run bcap validate --strict-live or bcap resume-check.",
